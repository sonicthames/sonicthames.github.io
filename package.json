{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "sonicthames.github.io",
  "homepage": "https://sonicthames.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "clsx": "2.1.1",
    "d3-interpolate": "3.0.1",
    "fp-ts": "2.16.11",
    "io-ts": "2.2.22",
    "luxon": "3.7.2",
    "mapbox-gl": "3.16.0",
    "pixi.js": "8.14.1",
    "posthog-js": "1.283.0",
    "react": "19.3.0-canary-fb2177c1-20251114",
    "react-dom": "19.3.0-canary-fb2177c1-20251114",
    "react-map-gl": "8.1.0",
    "react-responsive": "10.0.1",
    "react-router": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@cspell/dict-en-gb": "5.0.38",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-interpolate": "3.0.4",
    "@types/luxon": "3.7.1",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.4.1",
    "gh-pages": "6.3.0",
    "happy-dom": "21.0.4",
    "knip": "6.44.2",
    "oxc-transform-react": "0.156.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "catalog:",
    "rollup-plugin-visualizer": "7.1.3",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "vite build",
    "build:e2e": "VITE_MAPBOX_TOKEN=pk.test-playwright-token VITE_POSTHOG_KEY= vite build --outDir dist-e2e",
    "check": "pnpm peers check && pnpm lint && pnpm typecheck && pnpm spellcheck && pnpm test:coverage && pnpm build",
    "check:react-compiler": "oxlint -c oxlint.react-compiler.json --deny-warnings src",
    "check:type-aware": "oxlint -c oxlint.type-aware.json --type-aware --deny-warnings .",
    "check:unused": "knip --no-progress",
    "clean": "rm -rf dist",
    "deploy": "node scripts/deploy.ts",
    "dev": "vite",
    "dev:test": "vite --host 127.0.0.1 --port 4747",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "pnpm lint:biome && pnpm check:react-compiler && pnpm check:type-aware && pnpm check:unused",
    "lint:biome": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "mcp:discover": "node scripts/mcp-discover.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "postinstall": "node scripts/install-hooks.ts",
    "serve": "vite preview",
    "spellcheck": "cspell lint --no-progress .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "playwright test playwright/a11y.spec.ts",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "bin/visual-docker.sh",
    "test:visual:update": "bin/visual-docker.sh --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "26.x"
  }
}
