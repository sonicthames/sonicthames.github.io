{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Agent worktrees check out the whole repository under .claude/worktrees.
  "project": ["**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}", "!.claude/**"],
  // Specs import `playwright/test`, so knip's plugin does not enable itself
  // from an `@playwright/test` dependency.
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["playwright/**/*.spec.ts"]
  },
  // scripts/deploy.ts runs it through `pnpm exec`.
  "ignoreDependencies": ["gh-pages"],
  "ignoreExportsUsedInFile": {
    "type": true,
    "interface": true
  }
}
