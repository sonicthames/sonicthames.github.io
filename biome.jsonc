{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**/*", "!.claude", "!public", "!**/*.svg"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": { "formatter": { "selfCloseVoidElements": "always" } },
  "yaml": { "formatter": { "bracketSpacing": false } },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "all",
      "project": "all",
      "types": "all"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noGlobalDirnameFilename": "error",
        "useImportExtensions": "off",
        // Biome cannot resolve TS path aliases (@/, @theme/, @ui/)
        "noUndeclaredDependencies": "off",
        "noUnresolvedImports": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": { "ignoreNull": false }
        },
        "noConstantBinaryExpressions": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useErrorMessage": "error",
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": ["tailwind", "apply"]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      },
      "complexity": {
        "noUselessCatch": "error",
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },
      "style": {
        "useConst": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error",
        "useNamingConvention": "off",
        "useDefaultParameterLast": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noUselessElse": "error",
        "noNestedTernary": "off",
        "noEnum": "error"
      },
      "security": {
        "noSecrets": "off"
      },
      "performance": {
        "noDelete": "error",
        // The React Compiler memoizes inline handlers, so hand-written
        // useCallback wrappers would be noise.
        "noJsxPropsBind": "off"
      }
    }
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "overrides": [
    {
      // Node runs these directly as ES modules, without a bundler.
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "correctness": { "useImportExtensions": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "fp-ts/*",
                      "!fp-ts/lib/*",
                      "io-ts/*",
                      "!io-ts/lib/*"
                    ],
                    "message": "fp-ts and io-ts have no exports map, so Node cannot resolve this subpath; import from lib/*.js instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": { "allow": ["debug", "info", "warn", "error"] }
            }
          },
          "style": { "noProcessEnv": "error" }
        }
      }
    },
    {
      "includes": ["**/*.css.ts"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["src/icon/generated/**"],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ]
}
