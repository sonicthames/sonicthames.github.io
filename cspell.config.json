{
  "version": "0.2",
  "language": "en-GB",
  "import": ["@cspell/dict-en-gb/cspell-ext.json"],
  "useGitignore": true,
  "ignorePaths": [
    ".svelte-kit",
    ".playwright-mcp",
    ".vscode",
    "bin",
    "build",
    "coverage",
    "dist",
    "manual-tests",
    "node_modules",
    "out",
    "public",
    "scripts",
    "static",
    "pnpm-lock.yaml",
    "tsconfig.tsbuildinfo"
  ],
  "allowCompoundWords": false,
  "enableFiletypes": [
    "cjs",
    "css",
    "html",
    "json",
    "jsonc",
    "md",
    "mjs",
    "tsx",
    "ts",
    "jsx",
    "js",
    "yaml"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "dictionaries": ["en-gb"],
      "caseSensitive": false
    },
    {
      "languageId": [
        "typescript",
        "typescriptreact",
        "javascript",
        "javascriptreact"
      ],
      "dictionaries": ["en-gb"]
    }
  ],
  "words": [
    "affordances",
    "autocapture",
    "autodocs",
    "behaviour",
    "Behavioural",
    "color",
    "Crowish",
    "deepmerge",
    "direnv",
    "docgen",
    "domcontentloaded",
    "envrc",
    "esbuild",
    "Filenaming",
    "Flavor",
    "fontstack",
    "geolocated",
    "handoff",
    "joshwooding",
    "lefthook",
    "Manorway",
    "mapbox",
    "mapboxgl",
    "Maribor",
    "maxzoom",
    "minimatch",
    "minzoom",
    "modelcontextprotocol",
    "modestbranding",
    "networkidle",
    "Neue",
    "pageleave",
    "partialize",
    "POSTHOG",
    "Segoe",
    "segs",
    "signingkey",
    "sonicthames",
    "soundcycling",
    "svgr",
    "Tideslea",
    "timezone",
    "tsgolint",
    "unproject",
    "Validatable",
    "vcpu",
    "VITE",
    "vitejs",
    "WCAG",
    "worktrees",
    "xxxl",
    "xxxs"
  ],
  "ignoreRegExpList": ["/\"videoSrc\": \"[^\"]*\"/", "/GHSA(-[0-9a-z]{4}){3}/"]
}
